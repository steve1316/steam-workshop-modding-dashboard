# Copy this file to backend/.env and fill in what you use. Lines left commented out keep their default.
# The Settings page writes most of these back to .env for you.

# Translation provider
SWMT_TRANSLATION_PROVIDER=claude
SWMT_ANTHROPIC_API_KEY=
SWMT_OPENAI_API_KEY=
SWMT_DEEPL_API_KEY=
# SWMT_CLAUDE_MODEL=claude-sonnet-5-5
# SWMT_OPENAI_MODEL=gpt-4.1
# SWMT_BATCH_SIZE=100
# SWMT_BATCH_MAX_CHARS=6000
# SWMT_GLOSSARY_CATEGORIES=characters,mechanics

# Ollama
# SWMT_OLLAMA_BASE_URL=http://localhost:11434
# SWMT_OLLAMA_MODEL=qwen2.5:7b
# SWMT_OLLAMA_VRAM_TIER=

# llama.cpp
# SWMT_LLAMACPP_BASE_URL=http://localhost:8080
# SWMT_LLAMACPP_MODEL=
# SWMT_LLAMACPP_BINARY_PATH=llama-server
# SWMT_LLAMACPP_MODEL_PATH=
# SWMT_LLAMACPP_MODELS_DIR=backend/storage/models
# SWMT_LLAMACPP_GPU_LAYERS=-1
# SWMT_LLAMACPP_CTX_SIZE=8192
# SWMT_LLAMACPP_VRAM_TIER=

# Dashboard
# SWMT_API_PORT=8008
# SWMT_STORAGE_PATH=backend/storage
# SWMT_ACTIVE_GAME=chrono_ark
# SWMT_IGNORED_MODS=

# Chrono Ark
SWMT_BASE_GAME_PATH=C:\path\to\SteamLibrary\steamapps\common\Chrono Ark\ChronoArk_Data\StreamingAssets
SWMT_WORKSHOP_PATH=C:\path\to\SteamLibrary\steamapps\workshop\content\1188930

# Total War: Warhammer III
SWMT_TW3_HELPER_PATH=C:\path\to\totalwar-modding\helper_scripts
SWMT_TW3_RPFM_CLI_PATH=
SWMT_TW3_STEAM_LIBRARY_DRIVE=F:
SWMT_TW3_TRANSLATION_MODS_PATH=C:\path\to\totalwar-modding\warhammer3_mods

# Steam Workshop publishing
SWMT_STEAMCMD_PATH=
SWMT_STEAM_USERNAME=
